# ── Mode ─────────────────────────────────────────────────────────────────────
SOCIETY_MODE=real                 # real | mock   (mock = no model calls, random policy, clearly labelled)
SANDBOX_PROVIDER=process          # process | docker | daytona | e2b
AGENT_AUTH_MODE=gateway           # gateway (sandboxes get scoped keys via the orchestrator) | inherit (process provider only)

# ── Credentials (orchestrator only — never handed to agents) ─────────────────
ANTHROPIC_API_KEY=                # required for gateway mode
DAYTONA_API_KEY=
DAYTONA_API_URL=                  # optional
DAYTONA_SNAPSHOT=                 # snapshot built from docker/sandbox.Dockerfile (recommended)
E2B_API_KEY=
E2B_TEMPLATE=base

# ── Network ──────────────────────────────────────────────────────────────────
PORT=4000
ORCHESTRATOR_PUBLIC_URL=http://127.0.0.1:4000   # must be reachable FROM the sandboxes (docker: http://host.docker.internal:4000; daytona/e2b: a public tunnel URL)

# ── Society / economy ────────────────────────────────────────────────────────
ROOT_AGENTS=4
ROOT_BUDGET_USD=20
MAX_TOTAL_BUDGET_USD=100
MAX_TOTAL_AGENTS=24
MAX_CHILDREN_PER_AGENT=5
MAX_DEPTH=4
MAX_SANDBOX_LIFETIME_SEC=10800
EXPERIMENT_DURATION_SEC=1800
MAX_CONCURRENT_RUNS=8
MAX_RUN_SEC=900
IDLE_WAKE_SEC=120
MIN_RUN_BUDGET_USD=0.05
MIN_CHILD_BUDGET_USD=0.5
MESSAGE_FEE_USD=0.01
BROADCAST_FEE_USD=0.05
MAX_ARTIFACT_BYTES=26214400

# ── Models ───────────────────────────────────────────────────────────────────
AGENT_MODEL=claude-fable-5-1
AGENT_EFFORT=high                 # low | medium | high | xhigh | max
JUDGE_MODEL=claude-fable-5-1
ALLOWED_MODELS=claude-fable-5-1,claude-opus-5,claude-sonnet-5,claude-haiku-4-5-20251001
ROOT_PERMISSIONS=filesystem,shell,git,web,spawn,messaging,trade,publish
ALLOW_SUBAGENTS=false             # Claude Code's internal subagents would hide delegation from the society graph

# ── Judging weights ──────────────────────────────────────────────────────────
JUDGE_WEIGHT_OBJECTIVE=0.2
JUDGE_WEIGHT_LLM=0.5
JUDGE_WEIGHT_PEER=0.2
JUDGE_WEIGHT_HUMAN=0.1

# ── Misc ─────────────────────────────────────────────────────────────────────
DATA_DIR=experiments
DOCKER_IMAGE=agent-society-sandbox
DOCKER_NETWORK=
KEEP_ALIVE=0                      # 1 = keep sandboxes alive after judging
